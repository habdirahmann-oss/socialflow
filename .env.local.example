# Kopieer dit bestand naar .env.local en vul je sleutel in.
# Zonder key gebruikt de app een ingebouwde Nederlandse caption-generator.
# Met key schrijft Claude slimmere, passende captions per platform.

ANTHROPIC_API_KEY=

# Wachtwoord voor de app. Leeg = geen inlogscherm (handig lokaal).
APP_PASSWORD=

# Optioneel: geheim om de OAuth-state (koppelpogingen) te ondertekenen.
# Leeg = APP_PASSWORD, META_APP_SECRET of CRON_SECRET wordt gebruikt.
OAUTH_STATE_SECRET=
